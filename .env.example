# Optional overrides for `docker compose up`. Copy to .env and uncomment only
# what you set — a blank `KEY=` line is passed through as an empty string.
# The stack runs without this file, with AI features and email disabled.

# Enables AI resume feedback, mock interview questions, resume tailoring and
# the career assistant. Without it those features report "not configured".
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Sign session cookies with something other than the development default.
# JWT_SECRET_KEY=

# Password-reset email delivery. Without these the reset token is still
# created but never sent. For Gmail, use an App Password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Enables the scheduled-job endpoints; or run `python -m app.tasks refresh` directly.
# CRON_SECRET=
