DATABASE_URL=sqlite:///./offerflow.db
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=dev-secret-change-me-in-production-please-32b
JWT_EXPIRE_MINUTES=10080

# Set to "production" when deployed — switches the session cookie to
# SameSite=None + Secure, which is required once frontend and backend
# live on different domains (not just different localhost ports).
ENV=development

# Optional — AI resume feedback / mock interviews / career assistant degrade
# gracefully (status "not_configured") without this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:5173

# Optional — "Forgot password" silently skips sending an email without these
# (the reset token is still created, it just has no way to reach the user).
# For Gmail: use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for the scheduled-job endpoints (/internal/*). They're disabled
# when unset. Locally you can run them directly instead:
#   python -m app.tasks refresh   |   python -m app.tasks digest
CRON_SECRET=

# Company job boards to watch, as platform:board pairs (greenhouse, lever, ashby).
# Leave unset to use the built-in list.
# JOB_BOARDS=greenhouse:stripe,lever:palantir,ashby:ramp
