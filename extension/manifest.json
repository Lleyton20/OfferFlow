{
  "manifest_version": 3,
  "name": "OfferFlow",
  "short_name": "OfferFlow",
  "version": "1.0.0",
  "description": "Saves jobs to OfferFlow the moment you apply: role, company, description and hiring contacts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "OfferFlow",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/settings.js", "src/background.js"]
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.onrender.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/extract.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@offerflow.app",
      "strict_min_version": "121.0"
    }
  }
}
